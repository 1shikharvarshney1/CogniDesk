# ===================================================
# CogniDesk Client Environment Variables
# Copy this file to .env or .env.local if needed
# ===================================================

# Base URL for backend REST API (default is empty, using Vite development proxy)
# In production, set to your backend deployment URL, e.g. https://api.yourdomain.com
VITE_API_BASE_URL=

# Base URL for WebSocket connection (default connects to window.location.origin)
# In production, set to your backend Socket.io server URL
VITE_WS_URL=


# ===================================================
# CogniDesk Server Environment Variables
# Copy this file to .env and fill in your values
# ===================================================

# Port for the Node.js Express + Socket.io server
PORT=5000

# MongoDB connection string (Local instance or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/cognidesk

# Secret key used to sign and verify Agent JWT tokens (use a random 64-char string)
# Example generation: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# Frontend origin allowed for CORS and WebSocket handshake
CLIENT_ORIGIN=http://localhost:5173

# Google Gemini API Key for RAG assistant suggestions (Google AI Studio)
# Obtain a free key at: https://aistudio.google.com/apikey
# Leave empty to run the platform in mock AI mode
GEMINI_API_KEY=your_gemini_api_key_here

# Primary Gemini model used for suggested replies
GEMINI_MODEL=gemini-3.5-flash

# Fallback Gemini model triggered on upstream 429/503/404 errors
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Cooldown window (in seconds) between AI suggestion requests per agent
AI_COOLDOWN_SECONDS=5

# Knowledge base retrieval mode: text (default, MongoDB $text), vector (embedding cosine similarity), or hybrid (RRF k=60)
RETRIEVAL_MODE=text

# Gemini embedding model used for vector retrieval and article indexing
EMBEDDING_MODEL=gemini-embedding-001
